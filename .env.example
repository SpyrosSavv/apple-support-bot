# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# The defaults below work with `make deps-up` + `make dev` (services on localhost).
# docker compose overrides the service URLs for the containerised app.

# ── Required ──────────────────────────────────────────────────────────────────
# At least 32 characters. Generate one with:  openssl rand -hex 32
JWT_SECRET=
# Google AI Studio key (Gemini models)
GOOGLE_API_KEY=
# OpenAI key (faithfulness judge, and optional eval correctness judge)
OPENAI_API_KEY=
# Hugging Face read token with access to meta-llama/Llama-Prompt-Guard-2-86M
# (accept the model license on Hugging Face first). Used by the attack detector.
HF_TOKEN=

# ── Optional: LangSmith tracing ───────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=apple-support-bot

# ── Optional: PageIndex (only for `python -m scripts.index_docs --pdf ...`) ───
PAGEINDEX_API_KEY=

# ── Service URLs ──────────────────────────────────────────────────────────────
GPTCACHE_URL=http://localhost:8001
ATTACK_DETECTOR_URL=http://localhost:8002
MONGODB_URI=mongodb://localhost:27017
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/support_bot

# ── Models ("gpt*" / "o<digit>*" = OpenAI, anything else = Gemini) ────────────
LOW_COMPLEXITY_MODEL=gemini-3.5-flash
HIGH_COMPLEXITY_MODEL=gemini-3.1-pro
ROUTER_MODEL=gemini-3.5-flash
COMPLETENESS_JUDGE_MODEL=gemini-3.5-flash
FAITHFULNESS_JUDGE_MODEL=gpt-4o-mini

# ── Behaviour ─────────────────────────────────────────────────────────────────
ATTACK_DETECTOR_FAIL_OPEN=false
# Use ...-22M for faster, English-focused detection
ATTACK_DETECTOR_MODEL_ID=meta-llama/Llama-Prompt-Guard-2-86M
CACHE_ENABLED=true
FAITHFULNESS_THRESHOLD=0.7
COMPLETENESS_THRESHOLD=0.6
MAX_INPUT_CHARS=4000
MAX_SESSION_TURNS=10
RATE_LIMIT=30/minute
LOG_LEVEL=INFO
INCLUDE_TRACE_IN_RESPONSE=true

# ── Evals (python -m evals.run_evals) ─────────────────────────────────────────
EVAL_APP_URL=http://localhost:8000
# Must equal JWT_SECRET above
EVAL_JWT_SECRET=
EVAL_JUDGE_ENABLED=false